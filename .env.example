# ============================================================
# GALERT ENVIRONMENT CONFIGURATION
# Copy this file to .env and customize:
#   cp .env.example .env
# ============================================================

# Hardware Mode
# - On Linux (Raspberry Pi), defaults to false (real MPU-6050 & NEO-6M GPS)
# - Set MOCK_HARDWARE=true if testing without physical sensors connected
MOCK_HARDWARE=false

# GPS Serial Configuration
# - Raspberry Pi hardware UART (GPIO 14 TX, GPIO 15 RX): /dev/serial0
# - USB-to-UART GPS adapter: /dev/ttyUSB0
GPS_PORT=/dev/serial0
GPS_BAUDRATE=9600

# Email Alerts (Optional)
# Alerts are permanently saved to the local SQLite database (galert.db)
# regardless of whether email credentials are configured.
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=
