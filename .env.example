# ============================================================
# GALERT ENVIRONMENT CONFIGURATION
# Copy this file to .env and customize:
#   cp .env.example .env
# ============================================================

# Hardware Mode
# - On Linux (Raspberry Pi), defaults to false (real MPU-6050 & NEO-6M GPS)
# - Set MOCK_HARDWARE=true if testing without physical sensors connected
MOCK_HARDWARE=false

# GPS Serial Configuration
# - Raspberry Pi hardware UART (GPIO 14 TX, GPIO 15 RX): /dev/serial0
# - USB-to-UART GPS adapter: /dev/ttyUSB0
GPS_PORT=/dev/serial0
GPS_BAUDRATE=9600

# SMS Alerts (Preferred: Arkesel)
# Alerts are permanently saved to the local SQLite database (galert.db)
# regardless of whether SMS/email credentials are configured.
#
# Recommended setup:
# 1. Get an Arkesel API key.
# 2. Set the sender ID you want to send from.
# 3. Set the recipient phone number in international format.
# 4. Leave the email fields blank if using SMS only.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=GALERT
ARKESEL_PHONE=233XXXXXXXXX

# Email Alerts (Fallback)
# Use this only if you still want email alerts in addition to SMS.
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@yourdomain.com
EMAIL_RECEIVER=you@example.com

# Gmail SMTP fallback (Optional, only used if Resend is not configured)
EMAIL_SENDER=
EMAIL_PASSWORD=

# Google Maps Platform (Optional)
# - Provides high-precision Google Maps reverse geocoding for real Ghanaian locations:
GOOGLE_MAPS_API_KEY=

# Alert Persistence & Email Timing
# - Vibration must remain continuously at/above critical threshold (0.50 m/s²) for this duration before sending email:
CRITICAL_PERSISTENCE_SECONDS=2
# - If critical activity is ongoing continuously without pause, re-alert interval:
CRITICAL_REPEAT_SECONDS=60
# - Vibration must remain continuously high (0.15 m/s²) for this duration:
HIGH_PERSISTENCE_SECONDS=10
# - High activity email alert cooldown (seconds):
HIGH_ALERT_COOLDOWN_SECONDS=600
